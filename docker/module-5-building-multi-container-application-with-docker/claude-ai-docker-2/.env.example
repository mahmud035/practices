# Environment
NODE_ENV=development

# Server
PORT=5000

# Database
DB_URL=mongodb://localhost:27017/your-database-name

# JWT Secrets (CHANGE THESE - use long random strings)
JWT_ACCESS_SECRET=your-super-secret-access-key-change-this-immediately
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-immediately
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUND=12

# Cloudinary (Get these from your Cloudinary dashboard)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret